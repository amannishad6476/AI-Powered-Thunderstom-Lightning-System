# Backend Configuration
PROJECT_NAME="AI-Powered Thunderstorm & Lightning Nowcasting System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
HOST="0.0.0.0"
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL="sqlite+aiosqlite:///./nowcast.db"

# Data Sources / Satellite & Radar Endpoints (e.g. MOSDAC / IMD Open Data)
MOSDAC_API_KEY="your-mosdac-token-here"
IMD_RADAR_DATA_DIR="./data/radar"
INSAT_DATA_DIR="./data/satellite"

# Model Checkpoint Paths
CONVLSTM_MODEL_PATH="./ml_pipeline/model_checkpoints/convlstm_radar_nowcast.onnx"
LIGHTNING_MODEL_PATH="./ml_pipeline/model_checkpoints/lightning_risk_xgb.onnx"
